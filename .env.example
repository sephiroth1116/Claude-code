# Copy to .env and fill in what you need. Never commit the real .env file.

# Required only if sources.ebay.enabled is true in config.yaml.
# Get these from https://developer.ebay.com/my/keys (create an app, use production keys).
EBAY_APP_ID=
EBAY_CERT_ID=

# Required only if alerts.email.enabled is true in config.yaml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
